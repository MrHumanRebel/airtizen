#!/usr/bin/expect -f
set timeout 120

proc getenv {name default} {
  global env
  if {[info exists env($name)] && $env($name) ne ""} {
    return $env($name)
  }
  return $default
}

set workspace [getenv GITHUB_WORKSPACE [pwd]]
set profile [getenv TIZEN_PROFILE_NAME "AirTizen"]
set password [getenv TIZEN_CERT_PASSWORD ""]

if {$password eq ""} {
  puts "Error: TIZEN_CERT_PASSWORD is not set"
  exit 1
}

set tizen_bin "$workspace/tizen-studio/tools/ide/bin/tizen"
set build_dir "$workspace/app/.buildResult"
set release_dir "$workspace/app/release"

if {![file executable $tizen_bin]} {
  puts "Error: Tizen CLI not found or not executable: $tizen_bin"
  exit 1
}

if {![file isdirectory $build_dir]} {
  puts "Error: Tizen build result directory not found: $build_dir"
  exit 1
}

file mkdir $release_dir

spawn $tizen_bin package -t wgt -o $release_dir -s $profile -- $build_dir

expect {
  -re {(?i)author.*password.*:} {
    send -- "$password\r"
    exp_continue
  }
  -re {(?i)distributor.*password.*:} {
    send -- "$password\r"
    exp_continue
  }
  -re {(?i)certificate.*password.*:} {
    send -- "$password\r"
    exp_continue
  }
  -re {(?i)password.*:} {
    send -- "$password\r"
    exp_continue
  }
  -re {Yes: \(Y\), No: \(N\) \?} {
    send -- "N\r"
    exp_continue
  }
  timeout {
    puts "Error: Timeout waiting for tizen package to complete"
    exit 124
  }
  eof
}

set wait_result [wait]
set exit_code [lindex $wait_result 3]

if {$exit_code != 0} {
  puts "Error: tizen package failed with exit code $exit_code"
  exit $exit_code
}
