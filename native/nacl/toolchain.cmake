set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{NACL_SDK_ROOT})
  message(FATAL_ERROR "NACL_SDK_ROOT must point to the verified Samsung Pepper 47 SDK")
endif()
set(CMAKE_C_COMPILER "$ENV{NACL_SDK_ROOT}/toolchain/linux_pnacl/bin/arm-nacl-clang")
set(CMAKE_CXX_COMPILER "$ENV{NACL_SDK_ROOT}/toolchain/linux_pnacl/bin/arm-nacl-clang++")
set(CMAKE_AR "$ENV{NACL_SDK_ROOT}/toolchain/linux_pnacl/bin/arm-nacl-ar")
set(CMAKE_RANLIB "$ENV{NACL_SDK_ROOT}/toolchain/linux_pnacl/bin/arm-nacl-ranlib")
set(CMAKE_C_FLAGS_INIT "-ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-ffunction-sections -fdata-sections")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--gc-sections")
